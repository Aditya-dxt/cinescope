VITE_OMDB_API_KEY=demo
# --- Server (Vercel → Settings → Environment Variables). Never prefix with VITE_ ---
# ANTHROPIC_API_KEY=sk-ant-...  # server-side only, read by api/chat.ts (streaming). Client fallback works without it.
# --- Optional Firebase (enables per-user favourites + auth). Leave blank for localStorage demo mode ---
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
